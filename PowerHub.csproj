<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22621.0</TargetPlatformMinVersion>
    <RootNamespace>PowerHub</RootNamespace>
    <Version>0.5.0</Version>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Звичайний .exe без MSIX: не потрібні сертифікат і режим розробника.
         Windows App SDK вбудовується в збірку, тож окремо ставити Windows App Runtime не треба -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\**\*.*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Тести (tests/PowerHub.Tests) і перевірка без Windows (tools/check-build) — окремі проєкти, у збірку застосунку не входять -->
  <ItemGroup>
    <Compile Remove="tests\**;tools\**" />
    <None Remove="tests\**;tools\**" />
    <Page Remove="tests\**;tools\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.22621.3233" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.5.240802000" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.10" />
    <PackageReference Include="MQTTnet" Version="4.3.7.1207" />
    <PackageReference Include="Google.Protobuf" Version="3.28.3" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!-- Схеми protobuf для Delta 3 і Delta Pro 3 (з Android-версії, джерело — tolwi/hassio-ecoflow-cloud).
       C#-код згенеровано заздалегідь у Protocol\Proto\Generated: генерація під час збирання (Grpc.Tools)
       не працює з першим проходом XAML-компілятора WinUI. Як оновити — див. Protocol\Proto\README.md -->
  <ItemGroup>
    <None Include="Protocol\Proto\*.proto" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Api\" />
    <Folder Include="Protocol\" />
    <Folder Include="Data\" />
    <Folder Include="Services\" />
    <Folder Include="ViewModels\" />
    <Folder Include="Views\" />
    <Folder Include="Models\" />
    <Folder Include="Assets\" />
    <Folder Include="Helpers\" />
  </ItemGroup>
</Project>
