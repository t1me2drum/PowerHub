<Page
    x:Class="PowerHub.Views.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:PowerHub.Models"
    xmlns:views="using:PowerHub.Views"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок і дії -->
        <Grid Grid.Row="0" Padding="16,8,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Мої станції" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock x:Name="StatusText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
            <CommandBar Grid.Column="1" DefaultLabelPosition="Right" Background="Transparent" IsOpen="False" VerticalAlignment="Center">
                <AppBarButton x:Name="SyncButton" Icon="Sync" Label="Оновити список" Click="SyncButton_Click"
                              ToolTipService.ToolTip="Підтягнути станції з акаунта (ключі Developer API)"/>
                <AppBarButton Icon="Sort" Label="Сортування">
                    <AppBarButton.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyoutItem Text="Спершу онлайн" Click="SortOnline_Click"/>
                            <MenuFlyoutItem Text="За назвою" Click="SortName_Click"/>
                            <MenuFlyoutItem Text="За рівнем заряду" Click="SortSoc_Click"/>
                        </MenuFlyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
                <AppBarButton Icon="Add" Label="Додати" Click="AddButton_Click"/>
                <AppBarButton Icon="Setting" Label="Налаштування" Click="SettingsButton_Click"/>
            </CommandBar>
        </Grid>

        <!-- Стан з'єднання з хмарою (як ConnectionBanner в Android-версії) -->
        <InfoBar x:Name="ConnectionBar" Grid.Row="1" Margin="16,0,16,8" IsClosable="False" IsOpen="False"/>

        <Grid Grid.Row="2">
            <ProgressRing x:Name="SyncProgress" IsActive="False" Width="40" Height="40" VerticalAlignment="Top" Margin="0,24,0,0"/>

            <!-- Порожній список -->
            <StackPanel x:Name="EmptyPanel" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460" Spacing="12" Visibility="Collapsed">
                <TextBlock Text="Станцій ще немає" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="Додайте ключі Developer API в налаштуваннях, щоб підтягнути всі станції акаунта, або натисніть «Додати» і введіть серійний номер вручну."/>
                <Button Content="Додати станцію" Click="AddButton_Click" Style="{StaticResource AccentButtonStyle}"/>
            </StackPanel>

            <!-- Компактні картки; порядок змінюється перетягуванням -->
            <ListView x:Name="DevicesList"
                      ItemsSource="{x:Bind Devices}"
                      SelectionMode="None"
                      IsItemClickEnabled="True"
                      ItemClick="DevicesList_ItemClick"
                      CanReorderItems="True"
                      CanDragItems="True"
                      AllowDrop="True"
                      DragItemsCompleted="DevicesList_DragItemsCompleted"
                      Padding="12,0,12,16">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,8"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Device">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="12,10,4,10">
                            <Border.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Перейменувати" Tag="{x:Bind SerialNumber}" Click="RenameItem_Click"
                                                    Visibility="{x:Bind views:Ui.VisibleIf(CanRename)}">
                                        <MenuFlyoutItem.Icon>
                                            <SymbolIcon Symbol="Edit"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Видалити" Tag="{x:Bind SerialNumber}" Click="DeleteItem_Click">
                                        <MenuFlyoutItem.Icon>
                                            <SymbolIcon Symbol="Delete"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Border.ContextFlyout>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <views:SocRing RingSize="56" StrokeWidth="6"
                                               Soc="{x:Bind BatteryLevel, Mode=OneWay}"
                                               IsOnline="{x:Bind IsOnline, Mode=OneWay}"
                                               IsCharging="{x:Bind IsChargingFromGrid, Mode=OneWay}"/>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <!-- Рядок 1: назва й модель -->
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{x:Bind ModelName}" FontSize="12" VerticalAlignment="Bottom" Margin="0,0,0,1"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <!-- Рядок 2: вхід / вихід і стан мережі -->
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{x:Bind CardPowerText, Mode=OneWay}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{x:Bind CardGridAlertText, Mode=OneWay}" FontSize="13"
                                                   Foreground="{x:Bind views:Ui.AlertBrush(GridLevel), Mode=OneWay}"/>
                                    </StackPanel>
                                    <!-- Рядок 3: що робить батарея або коли були останні дані -->
                                    <TextBlock Text="{x:Bind CardStatusText, Mode=OneWay}" FontSize="13"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <FontIcon Grid.Column="2" Glyph="&#xE76F;" FontSize="16" Margin="8,0"
                                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                          ToolTipService.ToolTip="Перетягніть, щоб змінити порядок"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Десктопний дашборд: плитки в сітці (Налаштування → Вигляд головного екрана) -->
            <GridView x:Name="TilesGrid"
                      ItemsSource="{x:Bind Devices}"
                      SelectionMode="None"
                      IsItemClickEnabled="True"
                      ItemClick="DevicesList_ItemClick"
                      CanReorderItems="True"
                      CanDragItems="True"
                      AllowDrop="True"
                      DragItemsCompleted="DevicesList_DragItemsCompleted"
                      Padding="12,0,12,16"
                      Visibility="Collapsed">
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="Margin" Value="0,0,12,12"/>
                        <Setter Property="Padding" Value="0"/>
                    </Style>
                </GridView.ItemContainerStyle>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:Device">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8">
                            <Border.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Перейменувати" Tag="{x:Bind SerialNumber}" Click="RenameItem_Click"
                                                    Visibility="{x:Bind views:Ui.VisibleIf(CanRename)}">
                                        <MenuFlyoutItem.Icon>
                                            <SymbolIcon Symbol="Edit"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Видалити" Tag="{x:Bind SerialNumber}" Click="DeleteItem_Click">
                                        <MenuFlyoutItem.Icon>
                                            <SymbolIcon Symbol="Delete"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Border.ContextFlyout>
                            <views:StationTile Device="{x:Bind}"/>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </Grid>
    </Grid>
</Page>
